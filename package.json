{
  "name": "notion-terminal-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated remote MCP server exposing terminal and filesystem tools to Notion Custom Agents.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
